{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "score-request.v1",
  "type": "object",
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["reviewKey", "text", "batchDuplicate"],
        "properties": {
          "reviewKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "batchDuplicate": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
