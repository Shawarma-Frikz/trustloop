{
  "manifest_version": 3,
  "name": "TrustLoop",
  "description": "Estimates whether review text looks organic or manipulated.",
  "version": "0.0.1",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "TrustLoop",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.fr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://127.0.0.1:8080/*"]
}
